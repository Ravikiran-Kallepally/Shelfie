{
  "appId": "io.github.ravikirankallepally.shelfie",
  "appName": "Shelfie",
  "webDir": "www",
  "server": {
    "url": "https://shelfie-ravikiran.fly.dev",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "appendUserAgent": "ShelfieApp/0.1",
    "backgroundColor": "#f6f1e7"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 700,
      "launchAutoHide": true,
      "backgroundColor": "#f6f1e7",
      "showSpinner": false
    }
  }
}
